import { RealtimeSession, IDosGamesClient } from '@idosgames/core';
export { IDosGamesClient, SdkEvents } from '@idosgames/core';
import { ComponentType } from 'react';

/** `"<module-id>:<event>@<major>"`, e.g. `"idle-rpg:character-upgraded@1"`. */
type TopicName = `${string}:${string}@${number}`;
/** The exact grammar of a topic name. The part before ":" is the owning module's id. */
declare const TOPIC_NAME_RE: RegExp;
declare function isTopicName(value: unknown): value is TopicName;
/** The namespace (owning module id) of a topic name: `"idle-rpg:x@1"` → `"idle-rpg"`. */
declare function topicNamespace(name: string): string;
type ShapeLeaf = "string" | "number" | "boolean";
/** A leaf field: a type, optionally an array (`[]`), optionally optional (`?`, always last). */
type ShapeLeafSpec = ShapeLeaf | `${ShapeLeaf}[]` | `${ShapeLeaf}?` | `${ShapeLeaf}[]?`;
/** A flat JSON payload descriptor. Nested objects are allowed (and required when present). */
interface ShapeDescriptor {
    readonly [field: string]: ShapeLeafSpec | ShapeDescriptor;
}
type LeafType<L> = L extends "string" ? string : L extends "number" ? number : L extends "boolean" ? boolean : never;
type StripOptional<S extends string> = S extends `${infer B}?` ? B : S;
type SpecType<S> = S extends string ? StripOptional<S> extends `${infer L}[]` ? LeafType<L>[] : LeafType<StripOptional<S>> : S extends ShapeDescriptor ? InferShape<S> : never;
type OptionalKeys<D> = {
    [K in keyof D]: D[K] extends `${string}?` ? K : never;
}[keyof D];
type Simplify<T> = {
    [K in keyof T]: T[K];
} & {};
/** The TypeScript payload type described by a `ShapeDescriptor`. */
type InferShape<D> = Simplify<{
    -readonly [K in Exclude<keyof D, OptionalKeys<D>>]: SpecType<D[K]>;
} & {
    -readonly [K in OptionalKeys<D>]?: SpecType<D[K]>;
}>;
/** A payload shape: the descriptor plus its runtime check. `T` is the inferred payload type. */
interface Shape<T> {
    readonly descriptor: ShapeDescriptor;
    /** `null` when `value` fits, otherwise a short reason naming the first bad field. */
    check(value: unknown): string | null;
    /** Type-only marker carrying `T`; never set at runtime. */
    readonly __payload?: T;
}
/**
 * Describe a payload. `shape({ characterId: "string", level: "number", tags: "string[]?" })` is typed
 * `{ characterId: string; level: number; tags?: string[] }` and validates the same thing at runtime.
 */
declare function shape<const D extends ShapeDescriptor>(descriptor: D): Shape<InferShape<D>>;
/** A topic token: name + payload shape. Create with `defineTopic`, pass it to `ctx.events`. */
interface Topic<T> {
    readonly name: TopicName;
    readonly shape: Shape<T>;
}
/** The payload type of a topic token. */
type TopicPayload<X> = X extends Topic<infer T> ? T : never;
/**
 * Declare a topic. The name must start with the OWNING module's id — the host refuses to deliver an
 * emit into another module's namespace. Declare it in `module.meta.json` too (`events.emits` for your
 * own topics, `events.listens` for another module's), so the catalog and the agent can see it.
 */
declare function defineTopic<T>(name: TopicName, payload: Shape<T>): Topic<T>;
/**
 * Topics the HOST emits. The only topics a module may import: their owner is this npm package, not a
 * module. The `host:` namespace is closed to modules.
 */
declare const hostTopics: {
    /** The player switched modes via the nav. `from` is absent on the first activation. */
    readonly modeChanged: Topic<{
        to: string;
        from?: string | undefined;
    }>;
};
/**
 * `ctx.events` — this module's handle on the host's event bus.
 *
 * - `emit` only into your own namespace (`"<your-id>:…"`); anything else is dropped with an error.
 * - Subscribe in `setup()`, not in a panel effect: `activeOnly` panels unmount with their mode and
 *   would miss events. Subscriptions live for the session and the host removes them on logout.
 * - An event is a SIGNAL, not state, and is never replayed. Money, inventory and progress go through
 *   `ctx.client`; "what exists right now" goes through `ctx.sharedUi` and the SDK.
 * - Payloads are plain JSON — no functions, class instances or engine objects.
 */
interface ModuleEvents {
    emit<T>(topic: Topic<T>, payload: T): void;
    /** @deprecated Untyped string topics. Use `defineTopic(...)` and pass the token. */
    emit(topic: string, payload: unknown): void;
    /** Subscribe; returns an unsubscribe function. The handler only sees payloads that fit YOUR shape. */
    on<T>(topic: Topic<T>, handler: (payload: T) => void): () => void;
    /** @deprecated Untyped string topics. Use `defineTopic(...)` and pass the token. */
    on(topic: string, handler: (payload: unknown) => void): () => void;
}
/** One topic a module emits, as declared in `module.meta.json`. */
interface ModuleEventEmit {
    topic: TopicName;
    /** When it fires, in plain words. */
    when?: string;
    /** The descriptor passed to `shape()` — copied verbatim by listeners. */
    payload: ShapeDescriptor;
}
/** One topic a module listens to. Always optional: the module must work without the emitter. */
interface ModuleEventListen {
    topic: TopicName;
    /** What the module does with it. */
    why?: string;
}
interface ModuleEventsManifest {
    emits?: ModuleEventEmit[];
    listens?: ModuleEventListen[];
}

/**
 * The closed list of roles. Closed on purpose: a role is a promise "I draw this for everybody", so
 * each one has to mean the same thing across the whole catalog. A new role is a minor release of
 * this package; anything that does not fit a role is plain events + SDK data.
 */
declare const SHARED_UI_ROLES: readonly ["currency-bar", "wallet", "status", "account", "menu", "modes"];
type SharedUiRole = (typeof SHARED_UI_ROLES)[number];
/** Static declaration on a module (`Module.sharedUi`). */
interface ModuleSharedUi {
    /** Roles this module draws for every mode. The first provider in `src/modules.ts` wins a role. */
    provides?: readonly SharedUiRole[];
    /**
     * Roles this module relies on but does not draw (a shop that shows prices but no balance bar).
     * With no provider installed the host warns in dev, and the catalog tells the agent to install one.
     */
    requires?: readonly SharedUiRole[];
    /**
     * Roles this module draws INSIDE ITS OWN MODE while nobody `provides` them for everybody — a
     * template with a full-screen UI (bottom tab bar) puts "Log out" and the player's ID into its own
     * header instead of having the host float them over its layout. Only "account", "menu" and "modes"
     * are host-drawn, so those are the roles this matters for: the host hides its floating copy while this
     * module's mode is on screen and keeps drawing it in every other mode. `shouldDraw` of every module
     * is unchanged.
     */
    drawsOwn?: readonly SharedUiRole[];
}
/** `ctx.sharedUi` — the host's answer, fixed for the whole session. */
interface SharedUiContext {
    /** Which module draws `role` for everybody, or `null` when nobody took it. */
    ownerOf(role: SharedUiRole): string | null;
    /** Should THIS module draw its own copy: nobody took the role, or this module is its owner. */
    shouldDraw(role: SharedUiRole): boolean;
}
declare function isSharedUiRole(value: unknown): value is SharedUiRole;

/** Bytes of one file. Strings are UTF-8 encoded (JSON saves are the common case). */
type ContentFileData = Blob | ArrayBuffer | Uint8Array | string;
/** Something local the player can publish (a saved world, a level they built). */
interface LocalContentItem {
    id: string;
    name: string;
    /** Epoch ms of the last change — lists are shown newest first. */
    updatedAt?: number;
    /** One line under the name ("recipe world · 256×256"). */
    subtitle?: string;
}
/** What `capture` hands to the Workshop to publish. Roles and MIME types must fit the title's content type config. */
interface CapturedContent {
    files: Array<{
        role: string;
        contentType: string;
        data: ContentFileData;
    }>;
    thumbnail?: {
        contentType: "image/png" | "image/jpeg" | "image/webp";
        data: ContentFileData;
    };
    suggestedTitle?: string;
    suggestedDescription?: string;
    tags?: string[];
    metadata?: Record<string, string>;
}
/** What the Workshop hands to `open` after the player got access. */
interface DownloadedContent {
    contentID: string;
    title?: string | null;
    /** Revision of the publication — lets a game tell an update from a first download. */
    revision?: number | null;
    files: Array<{
        role: string;
        contentType: string;
        data: ArrayBuffer;
    }>;
}
interface ContentTypeHandler {
    /** Must equal a key of `Workshop.ContentTypes` in the title config (e.g. "voxelcraft.world"). */
    type: string;
    /** Shown in the Workshop's type filter and publish wizard. */
    label: string;
    icon?: string;
    /** Mode (route id) to switch to after `open` — the game that plays this content. */
    modeId?: string;
    /** Local items the player can publish. Omit when the type cannot be published from the game. */
    listLocal?(): Promise<LocalContentItem[]>;
    /** Serialize one local item for publishing. */
    capture?(localId: string): Promise<CapturedContent>;
    /** Load downloaded content into the game (import a world, start a level). */
    open?(content: DownloadedContent): Promise<void>;
}
/** `ctx.content` — the host's registry of content types, shared by every module of the session. */
interface ContentRegistry {
    /** Register (or replace) the handler of a type. Returns an unregister function. */
    registerType(handler: ContentTypeHandler): () => void;
    getType(type: string): ContentTypeHandler | undefined;
    listTypes(): ContentTypeHandler[];
    /** Called when a type is registered or removed (a UI re-renders its type list). */
    subscribe(listener: () => void): () => void;
}

/** Menu sections, in this order. */
type FeatureGroup = "economy" | "events" | "social" | "profile" | "other";
/** What the presenter hands to a feature's screen. */
interface FeatureScreenProps {
    /** What `open(id, args)` passed — e.g. `{ itemInstanceID }` to open straight on one item. */
    args?: Record<string, unknown>;
    /** Close the screen (go back to the menu / the lobby's first tab). */
    close(): void;
}
interface FeatureDefinition {
    /** Unique across the game — conventionally the owning module's id ("store"). */
    id: string;
    /** Menu label, already in the player's language. */
    label: string;
    /** Glyph name of @idosgames/react/ui ("shop", "hero"…), an emoji, or an image URL. */
    icon?: string;
    group?: FeatureGroup;
    /** Sort order within the group (and among the lobby's main tabs); lower first. */
    order?: number;
    /** A main tab of the lobby rather than an entry under "More". */
    primary?: boolean;
    /** The screen. Rendered by the presenter, inside the kit provider and the client provider. */
    Screen: ComponentType<FeatureScreenProps>;
    /**
     * Whether the title has something for this screen yet. Default `true`. A screen that depends on
     * title data (a shop without offers is an empty tab) registers with `false` and calls
     * `setAvailable(id, true)` once it has checked — so the tab never flashes in and out.
     */
    available?: boolean;
}
/** A registered feature plus its live badge and availability. */
interface FeatureEntry extends FeatureDefinition {
    badge: number;
    /** The module that registered it. */
    moduleId: string;
    /** Menus list only available features; `open()` of an unavailable one is refused. */
    available: boolean;
    /** Why it is hidden, in plain words — shown to the AI Coder's agent, never to players. */
    unavailableReason?: string;
}
/**
 * Shows a feature's screen. The menu owner registers one; the most recent presenter wins, and
 * unregistering hands the job back to the previous one (the lobby unmounts when the player switches
 * to a game → the host's window presents again).
 */
type FeaturePresenter = (id: string, args?: Record<string, unknown>) => boolean;
/** `ctx.features` — the registry of the game's features, shared by every module of the session. */
interface FeatureRegistry {
    /** Register (or replace) a feature. Returns an unregister function. */
    register(feature: FeatureDefinition): () => void;
    /** Features in registration order (menus sort them themselves). */
    list(): FeatureEntry[];
    get(id: string): FeatureEntry | undefined;
    /**
     * Opens a feature's screen through the current presenter. `false` — no such feature, it is not
     * available on this title, or no presenter.
     */
    open(id: string, args?: Record<string, unknown>): boolean;
    /** The "something to claim" counter of a feature; 0 hides it. */
    setBadge(id: string, count: number): void;
    /**
     * Show or hide a feature by what the title has (see `FeatureDefinition.available`). `reason` says
     * why it is hidden ("no store offers configured on the title") — the agent reads it.
     */
    setAvailable(id: string, available: boolean, reason?: string): void;
    /** Called on every registration, removal and badge change. */
    subscribe(listener: () => void): () => void;
    /** For menu owners: become the one who shows screens. Returns an unregister function. */
    setPresenter(presenter: FeaturePresenter): () => void;
}

/** A room setting the host picks when creating a room for the game (guest mode, cheats…). */
interface MultiplayerSetting {
    /** Key in `MultiplayerRoom.settings`. */
    id: string;
    /** Label, already in the player's language. */
    label: string;
    /** A choice of options, or an on/off switch. */
    kind: "choice" | "toggle";
    /** For `choice`: value + label of every option. */
    options?: Array<{
        value: string;
        label: string;
    }>;
    /** Value when the host does not change it. */
    default: string | boolean;
}
/** What a game declares about playing online (`ctx.multiplayer.registerGame`). */
interface MultiplayerGame {
    /** The game's mode (its route id) — the room's game and where "Play" takes the room. */
    mode: string;
    /** Label of the game in the rooms screen; defaults to the route's label. */
    label?: string;
    /**
     * Who connects to whom: `"Host"` (star — the host links to everyone, the others only to the host)
     * or `"Mesh"` (everyone to everyone). Default `"Mesh"`.
     */
    topology?: "Host" | "Mesh";
    /**
     * `"P2P"` — the game has its own chat over the DataChannels, the lobby draws none;
     * `"ServerRelay"` (default) — the lobby's room chat goes through the server.
     */
    chatMode?: "P2P" | "ServerRelay";
    /** Most players in one room (the title's limit caps it). Default 8. */
    maxPlayers?: number;
    /**
     * A player may join a room whose game is already running — the rooms screen lets them in and
     * `start` gets called for them right away (the game's own "late joiner" path). Default `false`.
     */
    joinInProgress?: boolean;
    /** Room settings the host picks on creation; the game reads them in `room.settings`. */
    settings?: MultiplayerSetting[];
    /**
     * The room goes into this game: switch the game to network play over `room.session`. Called on
     * EVERY member's device (the host's first) — after the app switched to the game's mode.
     */
    start(room: MultiplayerRoom): void | Promise<void>;
}
/** The room handed to a game. */
interface MultiplayerRoom {
    /** The live session — links, messages, members, host changes. Opened by the rooms system. */
    readonly session: RealtimeSession;
    /** The game's mode. */
    readonly mode: string;
    /** Whether this player created the game (the host at start). Live host: `session.hostId`. */
    readonly isHost: boolean;
    /** The room's settings as the host picked them (defaults filled in). */
    readonly settings: Readonly<Record<string, string | boolean>>;
    /**
     * The game joins a running room (`joinInProgress`) rather than starting together with it.
     */
    readonly lateJoin: boolean;
    /** Leave the room for good: closes the session and the rooms screen forgets it. */
    leave(): Promise<void>;
}
/** What `ctx.features.open("multiplayer", args)` understands. */
interface MultiplayerScreenArgs {
    /** Show only this game's rooms and preselect it in "Create a room". */
    mode?: string;
    /** Open straight on "Create a room" (a game's "Open for friends"). */
    create?: boolean;
}
/** `ctx.multiplayer` — the host's registry of games that play online, shared by every module. */
interface MultiplayerRegistry {
    /** A game declares that it plays online. Returns an unregister function. */
    registerGame(game: MultiplayerGame): () => void;
    getGame(mode: string): MultiplayerGame | undefined;
    listGames(): MultiplayerGame[];
    /** Called when a game is registered or removed. */
    subscribe(listener: () => void): () => void;
}

/** One piece of work on the loading screen. Call `done()` exactly once, also on failure. */
interface LoadingTask {
    /**
     * Progress 0..1 when it is known (a bar appears), `null` when it is not (just the spinner). An
     * optional new label replaces the current one ("Building terrain…", "Loading textures…").
     */
    progress(value: number | null, label?: string): void;
    done(): void;
}
interface LoadingReporter {
    /**
     * Show the loading screen until `done()`. Quick work never flashes it: the screen appears only if
     * the work is still running a moment later. `label` — what is loading, in the player's language.
     */
    begin(label?: string): LoadingTask;
    /** The loading screen while `work` runs; resolves or rejects with it. */
    track<T>(work: Promise<T>, label?: string): Promise<T>;
    /**
     * For work that BLOCKS the page (synchronous generation, a big parse): shows the screen at once,
     * waits until it is painted, then calls `work`. Calling heavy synchronous code straight after
     * `begin()` would freeze the page before the screen ever appears.
     */
    run<T>(work: () => T | Promise<T>, label?: string): Promise<T>;
}

/**
 * How important it is — decides the colour, the icon, the sound and how long a toast stays:
 *   info     — neutral news;                          success — something the player did worked;
 *   warning  — needs attention, nothing is lost yet;  error   — something failed (say what to do);
 *   reward   — the player received something.
 */
type NotificationLevel = "info" | "success" | "warning" | "error" | "reward";
interface NotificationAction {
    /** What `alert()` resolves with when this button is pressed. Defaults to the label. */
    id?: string;
    label: string;
    /** The main action — drawn as the coloured button. At most one. */
    primary?: boolean;
    /** Open this screen (a feature id, e.g. "quests") on press. */
    openFeature?: string;
    /** Called on press, before the notification closes. */
    onPress?: () => void;
}
interface NotificationInput {
    level?: NotificationLevel;
    /** A short headline. Optional for toasts, recommended for alerts. */
    title?: string;
    /** The text, already in the player's language. */
    message?: string;
    /**
     * An icon instead of the level's own: a UI-kit glyph name ("trophy", "gift", "chest"…), an emoji
     * or an image URL.
     */
    icon?: string;
    /** A picture: a thumbnail on a toast, a large image on an alert (an item, a banner, an avatar). */
    image?: string;
    /**
     * The system it belongs to — a feature id ("quests", "store"). Shows that screen's name and icon on
     * the notification, and a tap on the toast opens it. `ctx.notifications` fills in the calling
     * module's own id; pass `null` for none.
     */
    source?: string | null;
    /**
     * The same key replaces a notification that is still shown instead of adding one more ("Saving…"
     * → "Saved", the same error again). Identical toasts without a key are merged into one "×2".
     */
    key?: string;
    /** Toast only: how long it stays, ms. `0` — until the player closes it. Default by level. */
    duration?: number;
    /** Buttons. A toast shows the first one; an alert all of them (default: a single "OK"). */
    actions?: NotificationAction[];
}
interface AppNotifications {
    /** A toast. A bare string is an info toast. Returns its id (for `dismiss`). */
    toast(notification: NotificationInput | string): string;
    /**
     * An alert window, queued behind any other. Resolves with the pressed action's id, or `null` when
     * the player closed it without choosing.
     */
    alert(notification: NotificationInput): Promise<string | null>;
    /** Take a toast or a waiting alert away (an alert resolves with `null`). */
    dismiss(id: string): void;
}

/** What a module is, for catalog/UI purposes. Not every module is a game. */
type ModuleType = "game" | "app" | "ai-app";
/**
 * Rendering family a module needs a surface for. `"dom"` means no GPU renderer — a pure
 * React/DOM module (an app or AI app). The host mode-switches between different engines and may,
 * later, compose modules of the same engine family.
 */
type ModuleEngine = "three" | "phaser" | "dom";
interface ModuleMeta {
    /** Human-readable name shown in the catalog and nav. */
    name: string;
    type: ModuleType;
    /** Genre tag for games ("board", "idle-rpg", "sandbox", …). Optional for non-games. */
    genre?: string;
    engine: ModuleEngine;
}
/** A module's author, for catalog attribution. */
interface ModuleAuthor {
    name: string;
    url?: string;
}
/** Preview media for a module, as hosted URLs — modules never bundle binaries. */
interface ModuleMedia {
    /** Cover / preview image URL. */
    image?: string;
    /** Short preview or demo video URL. */
    video?: string;
}
/**
 * Catalog metadata for a module, authored as `module.meta.json` next to the module's package.json.
 *
 * This is NOT part of the runtime contract (`Module` / `ModuleMeta`) — the host never reads it. It
 * feeds three consumers: the Module & Skills Registry, the platform's module picker, and the AI
 * Coder's available-modules catalog. The last one is the point: the agent matches a publisher's
 * prompt against `provides` and reuses a ready module instead of rebuilding the same feature.
 *
 * A third-party author ships one by dropping this JSON into their module folder — no code, no build
 * step. Only `id`, `summary` and `provides` are required; `name`/`type`/`engine` come from the
 * runtime `ModuleMeta` in `module.ts` and need not be repeated here.
 */
interface ModuleManifest {
    /** Must equal the module's folder / registry id (e.g. "board-game"). */
    id: string;
    /**
     * The module's catalog type: `"template"` is a complete, ready-to-run game/app you start FROM
     * (e.g. voxelcraft — a full Minecraft-like sandbox); `"feature"` is a capability you ADD to a
     * project (a HUD, a shop, an event system, …). This is the catalog-facing type and is distinct
     * from the runtime `ModuleMeta.type` (`game | app | ai-app`) in `module.ts`. Defaults to
     * `"feature"`.
     */
    type?: "template" | "feature";
    /**
     * Part of the base: the platform installs this system into EVERY new project together with the base
     * (sign-in + the lobby) — only profile, inventory, invite, friends, quests and mailbox (owner's rule
     * 29.09.2026). Every other module is installed only when it is needed: a game brings the ones it
     * `uses`, the AI Coder installs any other one as soon as the task needs what it `provides`. A creator removes it like any module.
     */
    inBase?: boolean;
    /**
     * A game's modules: catalog ids of the systems this game plugs into (`ctx.multiplayer` →
     * `"multiplayer"`, `ctx.content` → `"workshop"`, …). The platform installs them together with the game
     * — a new title on this game gets them, and so does a project the AI Coder adds the game to.
     * `npm run check` makes a module that registers in `ctx.multiplayer` / `ctx.content` list them.
     */
    uses?: string[];
    /** Overrides the catalog display name; defaults to `ModuleMeta.name` from `module.ts`. */
    name?: string;
    /** One-line pitch shown on the catalog card. */
    summary: string;
    /** Longer description (Markdown allowed). */
    description?: string;
    /**
     * What functionality this module already implements, as plain feature phrases. The AI Coder
     * matches a user's request against these to decide whether to reuse the module rather than write
     * new code — so phrase them the way a publisher describes a feature ("turn-based dice movement",
     * "buy / upgrade tiles", "offline idle income"), not as file or API names.
     */
    provides: string[];
    /** Free-form tags for search and filtering. */
    tags?: string[];
    /** Preview media (hosted URLs — modules do not bundle binaries). */
    media?: ModuleMedia;
    /** Live, playable demo of just this module. */
    demoUrl?: string;
    /** Documentation link. */
    docsUrl?: string;
    author?: ModuleAuthor;
    /** Semver of the module content; defaults to the module's package.json `version`. */
    version?: string;
    /**
     * The module's event contract: topics it emits (with the payload descriptor listeners copy) and
     * topics of OTHER modules it listens to (always optional). `npm run check` in the SDK repo and the
     * AI Coder's hygiene notes compare this with the `defineTopic("…")` literals in `src/`.
     */
    events?: ModuleEventsManifest;
    /**
     * Data collections this module needs (the title's `DataCollections` section): collection id →
     * declaration, in the engine's JSON shape (`Kind`, `Fields`, `SortKeys`, `Access`, …). When the AI
     * Coder composes a project it merges them into the title config, so a module brings its own data
     * structures along instead of the agent re-inventing them. Ids MUST be prefixed with the module id
     * (`"guild-system:guilds"`) — two modules never collide. Roles the rules reference go to
     * `dataRoles`. Declare only what no ready platform module covers.
     */
    collections?: Record<string, unknown>;
    /** Title user roles the module's collection rules reference (role id → `{ DisplayName }`). */
    dataRoles?: Record<string, {
        DisplayName?: string;
        Description?: string;
    }>;
}
/**
 * The manifest a module exports. The host calls `setup` exactly once, passing shared services;
 * the module registers its scene/panels/routes and returns nothing.
 */
interface Module {
    /** Stable unique id — also the mode id the nav switches by. */
    id: string;
    meta: ModuleMeta;
    /**
     * Shared chrome this module draws for every mode (`provides`) or needs someone to draw
     * (`requires`). Static on purpose: the host reads it for ALL modules before the first `setup()`,
     * so `ctx.sharedUi` answers correctly whatever the module order. A template that draws its own
     * wallet/balances/status hides them when `ctx.sharedUi.shouldDraw(role)` is false.
     */
    sharedUi?: ModuleSharedUi;
    setup(ctx: ModuleContext): void;
}
/** Services the host injects into every module at `setup` time. */
interface ModuleContext {
    /** The one shared, already-authenticated SDK client. Modules never create their own. */
    client: IDosGamesClient;
    /**
     * The Title the host resolved at startup. Always use this — never re-read the title from the
     * URL inside a module: the host may have resolved it from the baked project config instead,
     * and a module that disagrees with its host talks to a different title's data.
     */
