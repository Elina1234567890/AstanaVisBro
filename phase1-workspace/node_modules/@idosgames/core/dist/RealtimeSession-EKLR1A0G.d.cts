    browse(query?: WorkshopBrowseQuery): Promise<OperationResult<WorkshopBrowseResponse>>;
    getContent(contentID: string): Promise<OperationResult<WorkshopContentResponse>>;
    getCollection(collectionID: string): Promise<OperationResult<WorkshopCollectionResponse>>;
    getCreatorProfile(creatorUserID: string, continuationToken?: string, pageSize?: number): Promise<OperationResult<WorkshopCreatorProfileResponse>>;
    /**
     * Full publication in one call: declare → upload by signed URLs → verify and release.
     * With `contentID` it uploads a NEW REVISION of your own publication (buyers get the new files).
