    /**
     * Когда данные устаревают по своему содержанию (конец окна ивента, ротация витрины) — epoch мс
     * или null. Время берётся из того, что прислал сервер, а не вычисляется заново на клиенте.
     */
    expiresAt?(data: T): number | null | undefined;
    /**
     * Контейнеры состояния игрока, от которых выборка зависит: сменилась их версия (`Rev`) —
     * копия выборки устарела. Так покупка, сдвинувшая `Store`, сама сбрасывает витрину.
     */
    readonly dependsOn?: readonly string[];
    /** События SDK, после которых копия устарела. */
    readonly invalidateOn?: readonly (keyof SdkEvents)[];
    /**
     * Имя выборки на сервере, если её можно получить ВМЕСТЕ со входом (`ClientState.Views`):
     * тогда вход приносит её сам, и отдельного запроса не будет. См. `DataCache.bindLoginView`.
     */
    readonly login?: string;
}
/** Параметры выборки во входе — всё, кроме имени и ключа. */
type LoginViewParams = Omit<ClientStateViewRequest, "Name" | "Key">;
/**
 * Какие выборки просить вместе со входом:
 * - `"auto"` (по умолчанию) — те, что игра читала в прошлый раз: кэш помнит их сам, ничего
 *   настраивать не нужно, а система, которую убрали из игры, сама выпадает из списка;
 * - `"all"` — все (`"*"`), включая варианты (каждую цепочку сезона, все лидерборды);
 * - `"none"` — ни одной (каждая выборка читается своим запросом, когда понадобится);
 * - список — ровно эти (имя или `{ Name, …параметры }`).
 */
