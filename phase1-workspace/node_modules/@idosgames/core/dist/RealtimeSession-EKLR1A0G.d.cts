/**
 * Серверная ВЫБОРКА — то, что сервер считает для игрока и чего нет ни в конфиге тайтла, ни в
 * состоянии игрока: витрина, активные ивенты, окно сезона, прогресс лидербордов, счётчики
 * непрочитанного. Объявляется один раз — дальше её читают через `DataCache.view`, и кэш сам
 * решает, отдать копию или сходить на сервер.
 */
interface CachedView<T> {
    /** Уникальное имя выборки. Выборка с аргументом (цепочка сезона) различается ключом `args`. */
    readonly key: string;
    /** Копия живёт не дольше этого (мс). Не задано — до инвалидации. */
