/**
 * Onboarding: flows of ordered steps that the server hands out, gates and closes.
 *
 * Two things the game must know before using this:
 *
 * 1. **Not every step is yours to close.** `completeStep` works only for steps whose
 *    `Completion.Mode` is `ClientAck` (or `Auto`, which closes on being shown). A `SystemEvent`
 *    step is closed by the backend off a real game event — a board roll, a purchase, a chest
 *    open — and calling `completeStep` on it is refused. Read `CurrentStep.Completion.Mode` from
 *    the flow view and only offer a "Next" button when it is `ClientAck`.
 * 2. **Progress can arrive on OTHER calls.** When a system-event step advances, the backend
 *    attaches it to the response of the action that caused it, and the SDK applies it to the
 *    cached state and emits `tutorial:systemProgress`. Subscribe to that instead of polling.
 */
declare class TutorialService {
    private readonly ctx;
    constructor(ctx: ClientContext);
    /** Flow and step definitions of the title (presets already resolved server-side). */
    getTutorialDefinitions(opts?: ReadOptions): Promise<OperationResult<TutorialDefinitions>>;
    /**
     * Player state plus everything needed to draw the current step without a second call.
     *
     * @param autoStart Let the server start flows marked for auto-start. Pass `false` from a
     * settings screen that merely lists tutorials — otherwise opening it would begin one.
     */
    /**
     * The player's flows (with the server's lazy transitions applied) — from the central cache until
     * the tutorial state changes (`Tutorial` `Rev`: a step, a start, a claim) or 5 minutes pass; the
     * login can bring it along.
     */
    getUserTutorialState(autoStart?: boolean, opts?: ReadOptions): Promise<OperationResult<GetUserTutorialStateResponse>>;
    private fetchUserTutorialState;
    private applyUserTutorialState;
    /** Start a flow explicitly. Returns the flow with its first step. */
    startFlow(flowID: string): Promise<OperationResult<TutorialFlowResponse>>;
    /**
     * Report that the step was shown to the player. Worth calling for every step: it is what the
     * funnel measures time-on-step from, and a step with `Mode = Auto` closes on it.
     */
    reportStepShown(flowID: string, stepID: string): Promise<OperationResult<TutorialFlowResponse>>;
    /**
     * Close the current step by the player's acknowledgement.
     * Refused for `SystemEvent`/`Composite` steps — those are closed by the game event itself.
     */
    completeStep(flowID: string, stepID: string): Promise<OperationResult<TutorialFlowResponse>>;
    /**
     * Close several steps of one flow, in order — for a client catching up after being offline.
     * Steps are closed one by one: closing the third without the second stays impossible.
     */
    completeStepsBatch(flowID: string, stepIDs: string[]): Promise<OperationResult<TutorialFlowBatchResponse>>;
    /** Skip one step (only if the step declares itself skippable). */
    skipStep(flowID: string, stepID: string): Promise<OperationResult<TutorialFlowResponse>>;
    /**
     * Skip the whole flow. Allowed only when the flow is skippable AND the current step is at or
     * past `Policy.SkippableFromOrder` — the flow view's `CanSkip` tells you whether to show the
     * button at all.
     */
    skipFlow(flowID: string): Promise<OperationResult<TutorialFlowResponse>>;
    /**
     * Take the completion reward. Show this when the flow view reports `RewardPending`.
     * A flow with `Reward.AutoClaim` pays out on its last step and never reports it pending.
     */
    claimFlowReward(flowID: string): Promise<OperationResult<TutorialClaimResponse>>;
    /**
     * Replay a flow. Only for flows whose `RestartPolicy` allows it; the reward is NOT granted
     * again — the server keeps the claimed flag through the reset.
     */
    resetFlow(flowID: string): Promise<OperationResult<TutorialFlowResponse>>;
    private flowCall;
    private stepCall;
    /** Могла ли эта операция выдать награду: потоковая AutoClaim (RewardClaimed сменился) или шаговая (Effects.Grant). */
    private mayHavePaid;
    /**
     * Fold the returned flow view into the cached player state. The view is authoritative for the
     * fields it carries, so the game can read `client.data.user.state.Tutorial` right after the
     * call without waiting for a state refresh.
     */
    private applyFlowView;
    /**
     * Batch and claim responses do not carry a flow view, so the cached state is re-read once.
     * Silent: a failed refresh must not turn a successful claim into an error for the player.
     */
    private refreshAfterMutation;
    private baseRequest;
}

/**
 * Community Marketing: the game's half of the creator reward programme.
 *
 * The programme itself — applying, submitting a post, moderation, metric polling and the accrual
 * maths — lives in the creator portal on the website, not in the game. The game surface is
 * deliberately three calls:
 *
 * 1. `getState()` — is the programme on, is this player in it, and WHERE to send them
 *    (`CreatorPortalUrl`). ⚠ Open that URL, never build one: the address is a server contract.
 * 2. `getEarnings()` — what the player has earned and why, including the per-work breakdown.
 * 3. `claim(campaignID)` — hand over the approved game-currency reward, or
 *    `withdrawCryptoReward(...)` for a crypto one.
 * 4. `checkJoinEligibility()` — only for `Automatic` participation mode: evaluate the
 *    publisher's join requirements against this player and, if they hold, admit them.
 *
 * **Four things worth knowing before you draw this screen:**
 *
 * - **⚠⚠ `Granted` is the promise; `Earned` and `Mature` are estimates.** The formula recomputes
 *   from metric snapshots, so `Earned` grows with views and DROPS when the platform scrubs fake
 *   activity. It becomes owed money only when a moderator approves it. `Claimable` counts from
 *   `Granted`, never from `Mature` — and a screen that shows only `Earned` will one day show a
 *   number going down with no explanation attached to it.
 * - **`Claimed: 0` is a success, not a failure.** Payouts are made in whole units, so a player
 *   with 0.4 currency approved gets zero and keeps the 0.4 (`RemainingFraction`). Show that number
 *   — without it the player concludes the platform ate their earnings.
 * - **`Mature` is not `Earned`.** An accrual matures after the title's hold period, because
 *   social platforms strip fake activity in the first days. Paying earlier would mean paying for
 *   that activity. `HoldDays` comes back with the earnings so the UI can say it out loud.
 * - **`IdempotentReplay: true` means the money moved on an earlier attempt.** A retried claim is
 *   safe and does not double-pay; say "already paid", not "paid again".
 */
declare class CommunityMarketingService {
    private readonly ctx;
    constructor(ctx: ClientContext);
    /**
     * Programme state for this player: whether it exists, whether they are a creator, and the
     * portal address to open.
     *
     * ⚠ Answers with a meaningful EMPTY state, not an error, for a player who never joined — that
     * is the normal case for anyone opening the screen.
     */
    getState(): Promise<OperationResult<CommunityMarketingState>>;
    /**
     * Earnings with the per-work breakdown.
     *
     * @param limit Payout history page size. 0 (default) leaves it to the module.
     */
    getEarnings(limit?: number): Promise<OperationResult<CommunityEarningsResponse>>;
    /**
     * Claim the APPROVED reward of one campaign, in game currency or items.
     *
     * It lands in the player's ordinary balance through the same path as any other reward, so the
     * usual state refresh applies.
     *
     * ⚠ Crypto campaigns are REFUSED here with `USE_WITHDRAW_FOR_CRYPTO` — use
     * {@link withdrawCryptoReward}. A crypto reward never touches the in-game balance: it leaves
     * the programme's pool bucket straight for the creator's wallet. That is a deliberate split —
     * an in-game crypto balance promises no payout (empty pool, no withdrawal, by design), while an
     * approved creator is owed the money regardless.
     */
    claim(campaignID: string): Promise<OperationResult<CommunityClaimResponse>>;
    /**
     * Withdraw an approved CRYPTO reward from the programme pool straight to `walletAddress`.
     *
     * Returns a server-signed voucher; submitting it on-chain is the wallet's job — the same call
     * `@idosgames/wallet` already makes for player withdrawals
     * (`submitEvmTokenWithdrawal(clients, data.EvmSignature)`, then
     * `client.blockchain.confirmWithdrawal({ TitleTransactionID, TransactionHash })`).
     *
     * ⚠⚠ THE POOL IS DEBITED AND THE REQUEST EXISTS THE MOMENT THIS RESOLVES, before anything
     * reaches the chain — exactly like an ordinary withdrawal. So "it failed, let me press it
     * again" charges a SECOND time. Keep `TitleTransactionID` and finish the interrupted one with
     * `confirmWithdrawal` (if the transaction actually landed) or `retryWithdrawal`; never ask for
     * a fresh voucher.
     *
     * ⚠ `amount` is a STRING in the invariant culture, and omitting it means "everything approved
     * and not yet paid".
     */
    withdrawCryptoReward(campaignID: string, walletAddress: string, amount?: string): Promise<OperationResult<CommunityWithdrawalResponse>>;
    /**
     * Evaluate the publisher's join requirements and, if they hold, join the programme.
     *
     * ⚠ Only meaningful while the programme's participation mode is `Automatic` and the player has
     * already applied — the application itself is created in the creator portal. In the
     * by-application mode the check still reports the breakdown but never admits anyone: that
     * decision belongs to a human.
     *
     * ⚠⚠ It never OVERRIDES a human. A creator a publisher rejected or suspended stays that way
     * even with every condition satisfied — otherwise this call would be "make myself approved".
     *
     * ⚠ Render `Conditions` — including on success. The programme pays for work by rules the person
     * never saw, and a bare "not allowed" reads as arbitrary. Mind that `Actual: null` means NOT
     * MEASURED, not zero.
     */
    checkJoinEligibility(): Promise<OperationResult<CommunityEligibilityResponse>>;
    private baseRequest;
}

/**
 * Player chat: persistent title channels and 1-on-1 conversations.
 *
 * **Three things to understand before wiring a UI to this.**
 *
 * 1. **One poll covers every room.** `poll()` returns updates for ALL rooms the player can see —
 *    channels and open conversations alike. Do not call it per channel: every call is billed
 *    against the publisher's API quota, so a per-channel loop multiplies that bill by the number
 *    of channels on every tick.
 *
 * 2. **The interval comes from the server, and you poll only while the chat is open.**
 *    `PollIntervalSeconds` arrives with `getChannels()` and with every poll, and the server may
 *    change it on the fly. When the chat screen is closed, stop polling: the unread badge is
 *    refreshed by `getChannels()` whenever the player opens the screen again.
 *
 * 3. **Polling never marks anything read.** That is deliberate — it is what keeps the poll a pure
 *    read on the server. Call `markRead()` when the player actually looks at a room, otherwise
 *    the badge stays lit forever.
 *
 * ⚠ `UnreadCount` is nullable and `null` means "not counted" (the server's hot cache was cold),
 * NOT zero. Render `null` as "unknown" — showing 0 would tell the player there is nothing new
 * when there might be.
 */
declare class ChatService {
    private readonly ctx;
    /** Cursors of the last poll, per room. Kept so the caller does not have to. */
    private readonly cursors;
    constructor(ctx: ClientContext);
    /** Channel catalog of the title (presets already resolved server-side). */
    getChatDefinitions(opts?: ReadOptions): Promise<OperationResult<ChatDefinitions>>;
    /**
     * Channels this player can see, with the room each of them resolves to for HIM, whether he
     * may write, and how much he has not read.
     *
     * Call it when the chat screen opens — it is also how you learn the poll interval and whether
     * the player is muted.
     */
    /**
     * Channels with their unread counts — other players write, so the copy lives 30 seconds; the
     * player's own message or read drops it.
     */
    getChannels(locale?: string, opts?: ReadOptions): Promise<OperationResult<ChatChannelsResponse>>;
    private fetchChannels;
    /**
     * What is new in every room since the last poll.
     *
     * Cursors are remembered by the service, so the usual call is `poll()` with no arguments.
     * New messages are emitted as `chat:messages` as well as returned.
     */
    poll(locale?: string): Promise<OperationResult<ChatPollResponse>>;
    /** A page of history, newest first. Pass the previous page's `NextBefore` to go further back. */
    getHistory(roomID: string, before?: ChatCursor, limit?: number): Promise<OperationResult<ChatHistoryResponse>>;
    /** Sends to a catalog channel. For a conversation use {@link sendDirect}. */
    sendMessage(channelID: string, text: string, locale?: string): Promise<OperationResult<ChatSendResponse>>;
    /**
     * Sends into a conversation.
     *
     * ⚠ Render `result.data.Message.Text`, not the string you passed in: with `Mask` moderation
     * the server returns the message with the offending word starred out, and showing the original
     * would put text on screen that nobody else can see.
     */
    sendDirect(roomID: string, text: string): Promise<OperationResult<ChatSendResponse>>;
    /** Opens (or returns) the conversation with another player. */
    openDirectChannel(targetUserID: string): Promise<OperationResult<ChatDirectChannelResponse>>;
    /** Conversations of this player, most recent first, each with its last message. */
    getConversations(): Promise<OperationResult<ChatConversationsResponse>>;
    /**
     * Marks a room read up to a message.
     *
     * ⚠ The ONLY thing that clears an unread badge — polling deliberately does not. Call it when
     * the player is actually looking at the room, not when the app merely fetched it.
     *
     * ⚠⚠ **With no cursor to fall back on, the server marks the room read up to NOW** — including
     * messages that arrived while the screen was opening and were never rendered. Those messages
     * then never arrive: the next poll starts from the cursor you just moved past them. So pass
     * `upTo` (or poll the room first) when you open a room; calling `markRead(roomID)` on a room
     * this service has never polled silently swallows whatever is newer than what you displayed.
     */
    markRead(roomID: string, upTo?: ChatCursor): Promise<OperationResult<ChatStateResponse>>;
    /** Joins an opt-in channel (one whose `JoinedByDefault` is false). */
    joinChannel(channelID: string): Promise<OperationResult<ChatStateResponse>>;
    /** Leaves a channel. It stays gone until the player joins again. */
    leaveChannel(channelID: string): Promise<OperationResult<ChatStateResponse>>;
    /**
     * Reports a message to the publisher.
     *
     * A repeat report of the same message succeeds with `AlreadyReported` — show a confirmation,
     * not an error: the player is being persistent, not wrong.
     */
    reportMessage(roomID: string, messageID: string, reason: ChatReportReason, comment?: string): Promise<OperationResult<ChatReportResponse>>;
    /**
     * Hides another player's messages for this player.
     *
     * One-sided and invisible to the other side: he can still post, and his messages simply stop
     * being delivered here. Filtering happens on the SERVER, so nothing arrives to be filtered.
     */
    ignoreUser(targetUserID: string): Promise<OperationResult<ChatStateResponse>>;
    /** Removes a player from the ignore list. */
    unignoreUser(targetUserID: string): Promise<OperationResult<ChatStateResponse>>;
    /** Forgets the remembered cursors — use it when switching account or leaving the screen. */
    resetCursors(): void;
    private baseRequest;
}

/** Options of {@link PushService.subscribe}. */
interface PushSubscribeOptions {
    /**
     * Where the service worker script lives, resolved against the page.
     *
     * Default `"./sw.js"` — deliberately RELATIVE. A hosted build runs on the title's own origin
     * (`{titleid}.idos.games`), where relative and root resolve alike; but a pinned version lives
     * under `/v/{buildId}/`, and legacy links still reach `cloud.idosgames.com/drive/app/{titleID}/`,
     * where a leading slash would point at another game's folder. Relative is right in every case.
     */
    swPath?: string;
    /** Overrides `navigator.language`. */
    locale?: string;
}
/**
 * Push notifications: getting this browser (or, in the portal, this player) subscribed.
 *
 * **The one rule that matters more than the rest of this file:** `subscribe()` must be called
 * from a real tap, and never on load. Browsers reject `Notification.requestPermission()` outside
 * a user gesture, and Chrome permanently blocks an origin after a few dismissals — so an
 * automatic prompt does not merely fail, it takes away the player's ability to ever say yes.
 *
 * **Draw the button from {@link getState}, not from a guess.** Four of its five values mean "no
 * button", each for a different reason: `unsupported` (no keys, or a browser without the Push
 * API), `blocked` (irreversible from code — only the browser's own settings undo it), `embedded`
 * (see below) and `subscribed`.
 *
 * ⚠⚠ **Inside the portal this works differently, and the difference is not fixable.** A game on
 * `idosgames.com/app/{id}` runs in a cross-origin iframe, where the browser blocks the permission
 * prompt outright. `subscribe()` therefore asks the WEBSITE to do it on its own top-level
 * document; the site writes the row against the player's platform identity, and the engine — this
 * backend — still does the sending. The player's game id reaches that row on their next platform
 * sign-in. So a portal subscription is real, it is just not this origin's, and `PushSubscribeResult.Where`
 * says which happened.
 *
 * **What the SDK deliberately does NOT do:**
 *
 * - It never computes a subscription's id. That is `sha256(endpoint)` and trivial to reproduce,
 *   but it addresses a shared database that already has two implementations guarded by golden
 *   vectors. A third one, in another language and without those vectors, drifts silently.
 * - It never ships a service worker. `templates/base/public/sw.js` is a starting point
 *   you own; the only hard requirement is that it must have NO `fetch` handler (see that file).
 * - It never asks again after `blocked`. There is nothing to ask.
 */
declare class PushService {
    private readonly ctx;
    constructor(ctx: ClientContext);
    private cachedConfig;
    /**
     * Public VAPID key and whether subscribing is possible at all.
     *
     * ⚠ **Never rejects and never returns an error.** "Could not ask" means exactly what "not
     * configured" means — no button — and one place should decide that, not every caller.
     * Memoised for the session; pass `refresh` after the publisher toggles the feature.
     */
    getConfig(refresh?: boolean): Promise<PushConfigResponse>;
    /** What to draw. See the note on {@link PushService} before branching on it. */
    getState(): Promise<PushPermissionState>;
    /**
     * Ask for permission and register this browser with the server.
     *
     * ⚠ **From a tap. Always.** See the class note — this is the one call where getting it wrong is
     * not recoverable by the player.
     *
     * Idempotent: an already-subscribed browser re-sends the same endpoint, which refreshes the
     * row's locale and timezone rather than creating a second one.
     */
    subscribe(options?: PushSubscribeOptions): Promise<OperationResult<PushSubscribeResult>>;
    /**
     * Stop notifying this browser ABOUT THIS TITLE: in the browser and on the server.
     *
     * ⚠ Both halves matter and neither implies the other. Dropping only the server row leaves a
     * browser that still holds a live endpoint; dropping only the browser one leaves a server row
     * that keeps being sent to until a push service answers 410.
     *
     * ⚠⚠ The server removes THIS TITLE's subscriptions of that device, not the device itself — it
     * deletes the device only once nothing is bound to it any more. A player of a portal game is
     * subscribed from idosgames.com, where one browser holds ONE endpoint serving the catalogue,
     * every other portal game and the creator portal: removing it here would silently cancel all
     * of that, which the player never asked for and cannot even see from inside this game.
     * "Unsubscribe from everything" lives on the website, where the whole list is on screen.
     */
    unsubscribe(): Promise<OperationResult<SuccessResponse>>;
    /**
     * Every device of this player in this title — the "my devices" screen.
     *
     * ⚠ Includes devices subscribed from the WEBSITE, not just this origin: one person's phone,
     * laptop and the portal tab are separate rows, and each is removed by its own `EndpointHash`.
     */
    getSubscriptions(): Promise<OperationResult<PushSubscriptionListResponse>>;
    /**
     * Stop notifying ONE device about this title, by the id the server issued for it.
