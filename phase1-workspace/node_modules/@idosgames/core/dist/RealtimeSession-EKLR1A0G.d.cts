        title?: string;
        description?: string;
        tags?: string[];
        metadata?: Record<string, string>;
        visibility?: WorkshopVisibility;
        access?: WorkshopAccessOptionInput[];
    }): Promise<OperationResult<WorkshopContentMutationResponse>>;
    /** Take it out of the catalog for good. Players who already have access keep it. */
    unpublish(contentID: string): Promise<OperationResult<WorkshopContentMutationResponse>>;
    getMyContent(contentType?: string, continuationToken?: string, pageSize?: number): Promise<OperationResult<WorkshopBrowseResponse>>;
    /**
