{
  "name": "@idosgames/core",
  "version": "0.21.2",
  "description": "Engine-agnostic core of the IDosGames SDK (transport, auth, cache, services, events).",
  "type": "module",
  "license": "MIT",
  "author": "iDos Games",
  "homepage": "https://github.com/iDos-Games/iDosGamesSDK_TS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDos-Games/iDosGamesSDK_TS.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/iDos-Games/iDosGamesSDK_TS/issues"
  },
  "keywords": [
    "idosgames",
    "sdk",
    "game",
    "gamedev",
    "telegram",
    "web3"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js",
      "require": "./dist/platform/index.cjs"
    },
    "./realtime": {
      "types": "./dist/realtime/index.d.ts",
      "import": "./dist/realtime/index.js",
      "require": "./dist/realtime/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/flatten-dts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "zod": "^4.4.3"
  }
}
