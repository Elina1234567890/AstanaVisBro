declare const WALLET_USE_SITE_PANEL = "WALLET_USE_SITE_PANEL";
/**
 * The page is the AI Coder's live preview, so the game's own wallet flows are allowed in its iframe.
 *
 * Decided by the page's HOSTNAME, not by a global: a game on its own address embedded on
 * idosgames.com can set any global it likes, but it cannot make itself run under a `-preview` host —
 * that host serves only the preview runtime and is framed only by the dashboard. The one extra case
 * is the local preview stand on a loopback address (`npm run preview:dev`), recognised by the marker
 * the preview runtime sets: on a developer's own machine there is nothing to protect.
 */
declare function isAiCoderPreview(hostname?: string): boolean;
/**
 * The page is inside an iframe. `window.self !== window.top` is the standard cross-origin-safe
 * check — it never throws, unlike reading `window.parent.location`, which is exactly why it works
 * the same whether the parent is idosgames.com or (in an exotic embedding this package cannot and
 * should not try to distinguish) anything else. Any iframe means "don't prompt for a signature
 * here" — that is a reasonable default even outside the platform's own embedding.
 */
declare function isEmbeddedInPlatform(): boolean;
/**
 * The page is embedded on SOMEBODY ELSE'S site, not on a platform page of our own.
 *
 * The platform offers a game to other sites through `idosgames.com/embed/{id}`, a thin page that
 * frames the game — so on a foreign site the game sits TWO frames deep (their page → our embed page
 * → the game), while on the platform's own app page it sits exactly one (`/app/{id}` → the game).
 * `window.parent !== window.top` is that difference, and it is the only signal available here: both
 * are cross-origin Window proxies, so they can be compared but not read.
 *
 * Why it matters (owner's decision, 2026-09-22): the "deposit and withdraw on idosgames.com" notice
 * belongs next to the site's own wallet panel — on OUR page, where that panel is right there on
 * screen. On a stranger's blog there is no panel, nothing the player can act on, and a wallet
 * message inside a small embedded window is noise at best. So there the wallet UI shows nothing at
 * all. Nothing about the actual barrier changes: wallet flows refuse in every iframe either way
 * ({@link isEmbeddedInPlatform}).
 */
declare function isEmbeddedOnForeignSite(): boolean;
/**
 * The site's wallet panel is the ONLY place a player can deposit/withdraw while this game is
 * embedded (see the module docblock above). After it completes an operation it posts
 * `{type: "IDOS_WALLET_BALANCE_CHANGED"}` to this page — a game that wants its on-screen balance
 * to update without the player reloading should call this once (e.g. in its HUD/wallet-display
 * setup) and refresh from `client.blockchain.getUserState()` when it fires. A no-op when not
 * embedded (the site panel doesn't exist there to send it) or outside the browser.
 *
 * Returns an unsubscribe function.
 */
declare function onWalletBalanceChanged(callback: () => void): () => void;

